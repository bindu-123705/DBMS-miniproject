# copy to .env.local
JWT_SECRET=change-me-to-a-long-random-string
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eveport
# one MySQL account per app role (created by db/mysql/04_rbac.sql)
DB_AUTH_USER=ep_auth
DB_AUTH_PASSWORD=Auth@12345
DB_STUDENT_USER=ep_student
DB_STUDENT_PASSWORD=Student@12345
DB_HEAD_USER=ep_head
DB_HEAD_PASSWORD=Head@12345
DB_ADMIN_USER=ep_admin
DB_ADMIN_PASSWORD=Admin@12345
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=eveport
